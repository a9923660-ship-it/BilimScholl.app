@charset "utf-8";

:root { --blue: #2457d6; --dark: #17243b; --green: #20a878; --bg: #f4f7fc; }

* { box-sizing: border-box; }

body { margin: 0px; font-family: Arial, sans-serif; color: var(--dark); background: var(--bg); }

header { background: white; padding: 17px 7%; display: flex; justify-content: space-between; align-items: center; gap: 15px; box-shadow: rgba(20, 38, 75, 0.043) 0px 2px 15px; position: sticky; top: 0px; z-index: 5; }

.logo { font-size: 25px; font-weight: 800; color: var(--blue); }

.logo span { color: var(--green); }

nav { display: flex; gap: 22px; }

nav a { text-decoration: none; color: rgb(83, 96, 120); font-size: 14px; }

.hero { padding: 65px 7% 55px; background: linear-gradient(125deg, rgb(23, 59, 153), rgb(50, 108, 233)); color: white; overflow: hidden; }

.hero-inner { max-width: 1100px; margin: auto; }

.tag { display: inline-block; background: rgba(255, 255, 255, 0.125); border: 1px solid rgba(255, 255, 255, 0.27); border-radius: 30px; padding: 9px 15px; font-size: 13px; }

h1 { font-size: clamp(34px, 5vw, 56px); line-height: 1.12; max-width: 700px; margin: 23px 0px 16px; }

.hero p { line-height: 1.7; max-width: 570px; color: rgb(225, 234, 255); }

.search { display: flex; max-width: 620px; margin-top: 28px; background: white; border-radius: 12px; padding: 6px; gap: 8px; }

.search input { min-width: 0px; flex: 1 1 0%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; padding: 13px; font-size: 15px; }

button { border: 0px; cursor: pointer; border-radius: 9px; padding: 12px 18px; font-weight: bold; background: var(--blue); color: white; }

.search button { background: var(--green); }

.stats { display: flex; gap: 35px; margin-top: 30px; flex-wrap: wrap; }

.stats strong { display: block; font-size: 23px; margin-bottom: 5px; }

.stats span { color: rgb(220, 230, 255); font-size: 13px; }

main { max-width: 1100px; margin: auto; padding: 42px 22px 70px; }

.section-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 23px; }

h2 { font-size: 27px; margin: 0px 0px 8px; }

.muted { color: rgb(113, 128, 152); font-size: 14px; }

.classes { display: grid; grid-template-columns: repeat(6, 1fr); gap: 13px; }

.class-card { background: white; border: 2px solid transparent; border-radius: 15px; padding: 19px 8px; cursor: pointer; text-align: center; transition: 0.2s; }

.class-card:hover, .class-card.active { border-color: var(--blue); transform: translateY(-3px); box-shadow: rgba(36, 87, 214, 0.082) 0px 8px 25px; }

.class-card .number { font-size: 27px; font-weight: 800; color: var(--blue); }

.class-card small { display: block; margin-top: 7px; color: rgb(113, 128, 152); }

.filter-row { display: flex; gap: 10px; margin: 25px 0px; flex-wrap: wrap; }

select { background: white; border: 1px solid rgb(220, 227, 239); border-radius: 9px; padding: 12px; color: var(--dark); max-width: 100%; }

.books { display: grid; grid-template-columns: repeat(3, 1fr); gap: 17px; }

.book { background: white; border: 1px solid rgb(233, 237, 245); border-radius: 15px; padding: 20px; transition: 0.2s; }

.book:hover { box-shadow: rgba(24, 44, 80, 0.063) 0px 8px 25px; }

.book-top { display: flex; align-items: center; gap: 13px; margin-bottom: 17px; }

.book-icon { width: 53px; height: 61px; flex-shrink: 0; display: grid; place-items: center; border-radius: 9px; background: rgb(232, 239, 255); font-size: 27px; }

.book h3 { margin: 0px 0px 7px; font-size: 17px; }

.book p { color: rgb(113, 128, 152); font-size: 13px; line-height: 1.5; }

.book-actions { display: flex; gap: 8px; margin-top: 18px; }

.book-actions button { flex: 1 1 0%; font-size: 12px; padding: 11px 7px; }

.book-actions .secondary { background: rgb(234, 240, 255); color: var(--blue); }

.empty { grid-column: 1 / -1; text-align: center; background: white; padding: 35px; border-radius: 14px; color: rgb(113, 128, 152); line-height: 1.7; }

.notice { margin-top: 27px; background: rgb(234, 248, 242); border: 1px solid rgb(209, 238, 225); padding: 18px; border-radius: 12px; color: rgb(40, 102, 79); font-size: 14px; line-height: 1.7; }

footer { background: rgb(23, 36, 59); color: rgb(203, 213, 231); text-align: center; padding: 30px 20px; font-size: 13px; line-height: 1.8; }

@media (max-width: 800px) {
  .classes { grid-template-columns: repeat(4, 1fr); }
  .books { grid-template-columns: repeat(2, 1fr); }
  nav { gap: 12px; }
}

@media (max-width: 520px) {
  header { padding: 15px 5%; }
  nav a:not(:last-child) { display: none; }
  .hero { padding: 45px 6%; }
  .classes { grid-template-columns: repeat(3, 1fr); }
  .books { grid-template-columns: 1fr; }
  .search button { padding: 10px; }
  .stats { gap: 20px; }
}
